<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >

    <PropertyGroup Label="Configuration" >
        <EnableModZip>false</EnableModZip>
        <RunCommand>dotnet-SDV</RunCommand>
        <Configuration Condition="'$(RELEASE)' != ''" >Release</Configuration>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MODE)' == 'steam'" Label="Steam" >
        <GamePath>$(HOME)/.steam/steam/steamapps/common/Stardew Valley</GamePath>
        <RunArguments>steam</RunArguments>
    </PropertyGroup>

    <PropertyGroup Label="Compile Flags" >
        <DefineConstants Condition="'$(EnableHarmony)' == 'true'"
                >$(DefineConstants);TOWERCORE_USING_HARMONY</DefineConstants>
        <DefineConstants Condition="'$(Tower_EnableCrossConfig)' == 'true'"
                >$(DefineConstants);TOWERCORE_USING_CROSSCONFIG</DefineConstants>
        <Tower_EnableNewtonsoft Condition="'$(Tower_EnableCrossConfig)' == 'true'"
                >true</Tower_EnableNewtonsoft>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="$(MSBuildThisFileDirectory)lib\*.cs" />
        <Reference Condition="'$(Tower_EnableNewtonsoft)' == 'true'" Include="Newtonsoft.Json"
                HintPath="$(GamePath)\smapi-internal\Newtonsoft.Json.dll" Private="False" />
    </ItemGroup>

</Project>
