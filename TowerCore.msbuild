<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >
    <PropertyGroup Label="Configuration" >
        <Import_RootNamespace>ichortower.TowerCore</Import_RootNamespace>
    </PropertyGroup>
    <PropertyGroup Label="Compile Flags" >
        <DefineConstants Condition="'$(EnableHarmony)' == 'true'"
                >$(DefineConstants);TOWERCORE_USING_HARMONY</DefineConstants>
        <DefineConstants Condition="'$(Tower_EnableNewtonsoft)' == 'true'"
                >$(DefineConstants);TOWERCORE_USING_NEWTONSOFT</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="$(MSBuildThisFileDirectory)lib\*.cs" />
        <Reference Condition="'$(Tower_EnableNewtonsoft)' == 'true'" Include="Newtonsoft.Json"
                HintPath="$(GamePath)\smapi-internal\Newtonsoft.Json.dll" Private="False" />
    </ItemGroup>
</Project>
